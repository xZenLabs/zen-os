#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ZEN_UI_TEST_FOREGROUND=0
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--fg" ]]; then
    export ZEN_UI_TEST_FOREGROUND=1
  else
    ARGS+=("$arg")
  fi
done
COMMAND="${ARGS[0]:-}"
LOCK_FILE="$ROOT/spec/koreader-lock.json"
ARTIFACTS="$ROOT/spec/.artifacts"

# Set SDL2/SDL3 focus behavior for Lua tests and emulator windows.
export SDL_MAC_BACKGROUND_APP=$((1 - ZEN_UI_TEST_FOREGROUND))
export SDL_WINDOW_NO_ACTIVATION_WHEN_SHOWN="$SDL_MAC_BACKGROUND_APP"
export SDL_WINDOW_ACTIVATE_WHEN_SHOWN="$ZEN_UI_TEST_FOREGROUND"
export SDL_WINDOW_ACTIVATE_WHEN_RAISED="$ZEN_UI_TEST_FOREGROUND"

usage() {
  cat <<'EOF'
Usage: ./spec/run [--fg] <lua|smoke|full|nightly-smoke|legacy-upgrade|update-goldens|package-check|website-screenshots>

Set KOREADER_DIR to a KOReader emulator/runtime directory containing luajit,
frontend, and the Busted rocks under spec/rocks. The runtime is never mutated.
Smoke, full, and nightly-smoke always run the real KOReader emulator.
Use --fg to allow desktop focus; the default is background mode.
EOF
}

find_runtime() {
  if [[ -n "${KOREADER_DIR:-}" ]]; then
    printf '%s\n' "$KOREADER_DIR"
    return
  fi
  local parent
  parent="$(cd "$ROOT/.." && pwd)"
  local candidate
  for candidate in "$parent"/koreader/koreader-emulator-*/koreader; do
    if [[ -x "$candidate/luajit" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  return 1
}

require_runtime() {
  if [[ -z "${KOREADER_DIR:-}" ]] && ! find_runtime >/dev/null 2>&1; then
    KOREADER_DIR="$($ROOT/spec/provision-koreader.sh stable)"
  fi
  RUNTIME="$(find_runtime)" || {
    echo "No KOReader runtime found. Set KOREADER_DIR; pins are in $LOCK_FILE." >&2
    exit 2
  }
  [[ -x "$RUNTIME/luajit" ]] || { echo "Missing KOReader LuaJIT: $RUNTIME/luajit" >&2; exit 2; }
  [[ -d "$RUNTIME/spec/rocks" ]] || { echo "Missing KOReader Busted rocks: $RUNTIME/spec/rocks" >&2; exit 2; }
  [[ -d "$RUNTIME/plugins/coverbrowser.koplugin" ]] || {
    echo "Missing bundled KOReader CoverBrowser plugin: $RUNTIME/plugins/coverbrowser.koplugin" >&2
    exit 2
  }
}

report_test_results() {
  python3 - "$@" <<'PY'
import sys
import xml.etree.ElementTree as ET

reports = list(zip(sys.argv[1::2], sys.argv[2::2]))
failed = []

print("\n========== Test results ==========")
for label, report in reports:
    try:
        root = ET.parse(report).getroot()
    except (OSError, ET.ParseError):
        print(f"{label}: no report")
        continue

    results = root.attrib
    if "tests" not in results:
        results = {
            key: str(sum(int(suite.get(key, 0)) for suite in root.findall("testsuite")))
            for key in ("tests", "failures", "errors", "skip", "skipped")
        }
    tests = int(results.get("tests", 0))
    failures = int(results.get("failures", 0))
    errors = int(results.get("errors", 0))
    skipped = int(results.get("skip", 0)) or int(results.get("skipped", 0))
    passed = tests - failures - errors - skipped
    print(f"{label}: {passed} passed, {skipped} skipped, {failures} failed, {errors} errors")

    for case in root.iter("testcase"):
        for outcome in case:
            if outcome.tag not in ("failure", "error"):
                continue
            message = " ".join((outcome.get("message") or outcome.text or "").split())
            failed.append((label, case.get("name", "unnamed test"), message))

if failed:
    print("\nFailing tests:")
    for label, name, message in failed:
        print(f"  [FAIL] {label}: {name}")
        if message:
            print(f"         {message}")
print("==================================")
PY
}

run_lua() {
  require_runtime
  local luacheck_bin="$ROOT/.luarocks/bin/luacheck"
  if [[ ! -x "$luacheck_bin" ]]; then luacheck_bin="$(command -v luacheck)"; fi
  "$luacheck_bin" -q _meta.lua main.lua common config modules spec/lua spec/python/zen_ui_test_driver.koplugin
  local ko_home
  ko_home="$(mktemp -d "${TMPDIR:-/tmp}/zen-ui-spec-home.XXXXXX")"
  trap "rm -rf '$ko_home'" RETURN
  mkdir -p "$ARTIFACTS/lua"
  (
    cd "$RUNTIME"
    export KO_HOME="$ko_home"
    export ZEN_UI_ROOT="$ROOT"
    export LUA_PATH="$ROOT/?.lua;$ROOT/?/init.lua;$ROOT/spec/lua/support/?.lua;?.lua;common/?.lua;frontend/?.lua;spec/rocks/share/lua/5.1/?.lua;spec/rocks/share/lua/5.1/?/init.lua"
    export LUA_CPATH="?.so;common/?.so;spec/rocks/lib/lua/5.1/?.so"
    local lua_status=0
    ./luajit -e 'require "busted.runner" { standalone = false }' /dev/null \
      --output=junit -Xoutput="$ARTIFACTS/lua/junit.xml" \
      --helper="$ROOT/spec/lua/support/helper.lua" \
      --pattern="_spec" "$ROOT/spec/lua" || lua_status=$?
    if [[ ! -f "$ARTIFACTS/lua/junit.xml" ]]; then
      echo "Lua test runner exited without a JUnit report" >&2
      if [[ "$lua_status" -eq 0 ]]; then
        exit 1
      fi
      exit "$lua_status"
    fi
    if [[ "$lua_status" -ne 0 ]]; then
      exit "$lua_status"
    fi
    if grep -Eq "<testsuites[^>]*(failures|errors)='[1-9]" "$ARTIFACTS/lua/junit.xml"; then
      exit 1
    fi
  )
}

ensure_python() {
  local python="$ROOT/spec/.venv/bin/python"
  if [[ ! -x "$python" ]]; then
    python3 -m venv "$ROOT/spec/.venv"
  fi
  if ! "$python" -c 'from PIL import Image; import pytest, pyautogui' >/dev/null 2>&1; then
    "$python" -m pip install --requirement "$ROOT/spec/python/requirements.txt" >&2
  fi
  printf '%s\n' "$python"
}

stage_runtime() {
  require_runtime
  local staged_plugin_dir="${ZEN_UI_STAGED_PLUGIN_DIR:-zenos.koplugin}"
  if [[ "$staged_plugin_dir" != "zenos.koplugin" && "$staged_plugin_dir" != "zen_ui.koplugin" ]]; then
    echo "Unsupported staged plugin directory: $staged_plugin_dir" >&2
    return 2
  fi
  local staged_runtime
  staged_runtime="$(mktemp -d "${TMPDIR:-/tmp}/zen-ui-spec-runtime.XXXXXX")"
  local item
  for item in "$RUNTIME"/*; do
    ln -s "$item" "$staged_runtime/$(basename "$item")"
  done
  rm "$staged_runtime/plugins"
  mkdir "$staged_runtime/plugins"
  for item in "$RUNTIME"/plugins/*; do
    local plugin_name
    plugin_name="$(basename "$item")"
    if [[ "$plugin_name" == "zenos.koplugin" || "$plugin_name" == "zen_ui.koplugin" || "$plugin_name" == "zen_ui_test_driver.koplugin" ]]; then
      continue
    fi
    ln -s "$item" "$staged_runtime/plugins/$plugin_name"
  done
  rsync -a --exclude '.git/' --exclude '.luarocks/' --exclude 'dist/' --exclude 'spec/' \
    "$ROOT/" "$staged_runtime/plugins/$staged_plugin_dir/"
  rsync -a "$ROOT/spec/python/zen_ui_test_driver.koplugin/" \
    "$staged_runtime/plugins/zen_ui_test_driver.koplugin/"
  printf '%s\n' "$staged_runtime"
}

run_python() {
  local target="$1"
  local python
  python="$(ensure_python)"
  local staged_runtime=""
  if [[ "${ZEN_UI_RUN_EMULATOR:-0}" == "1" ]]; then
    staged_runtime="$(stage_runtime)"
  fi
  local python_status=0
  local pytest_target="${ZEN_UI_PYTEST_TARGET:-$ROOT/spec/python/tests}"
  local report_name="${ZEN_UI_PYTHON_REPORT:-junit.xml}"
  mkdir -p "$ARTIFACTS/python"
  PYTHONPATH="$ROOT/spec/python" KOREADER_DIR="$staged_runtime" \
    "$python" -m pytest "$pytest_target" -q \
      --junitxml="$ARTIFACTS/python/$report_name" || python_status=$?
  if [[ -n "$staged_runtime" ]]; then rm -rf "$staged_runtime"; fi
  return "$python_status"
}

run_website_screenshots() {
  local python
  python="$(ensure_python)"
  if [[ "${1:-}" == "--list" || "${1:-}" == "--audit" ]]; then
    PYTHONPATH="$ROOT/spec/python" "$python" -m website_screenshots "$@"
    return
  fi
  local staged_runtime
  staged_runtime="$(stage_runtime)"
  local capture_status=0
  PYTHONPATH="$ROOT/spec/python" KOREADER_DIR="$staged_runtime" \
    "$python" -m website_screenshots "$@" || capture_status=$?
  rm -rf "$staged_runtime"
  return "$capture_status"
}

validate_legacy_upgrade_report() {
  python3 - "$1" <<'PY'
import sys
import xml.etree.ElementTree as ET

report = sys.argv[1]
try:
    root = ET.parse(report).getroot()
except (OSError, ET.ParseError) as error:
    print(f"Legacy upgrade did not produce a valid JUnit report: {error}", file=sys.stderr)
    raise SystemExit(1)

results = root.attrib
if "tests" not in results:
    results = {
        key: str(sum(int(suite.get(key, 0)) for suite in root.findall("testsuite")))
        for key in ("tests", "failures", "errors", "skip", "skipped")
    }
tests = int(results.get("tests", 0))
failures = int(results.get("failures", 0))
errors = int(results.get("errors", 0))
skipped = int(results.get("skip", 0)) or int(results.get("skipped", 0))
passed = tests - failures - errors - skipped
if (tests, passed, skipped, failures, errors) != (1, 1, 0, 0, 0):
    print(
        "Legacy upgrade requires exactly 1 passing test "
        f"(found {passed} passed, {skipped} skipped, "
        f"{failures} failed, {errors} errors)",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

run_legacy_upgrade() {
  local python_status=0
  local report_status=0
  local report_name="junit-legacy-upgrade.xml"
  ZEN_UI_RUN_EMULATOR=1 \
    ZEN_UI_STAGED_PLUGIN_DIR=zen_ui.koplugin \
    ZEN_UI_LEGACY_UPGRADE=1 \
    ZEN_UI_PYTEST_TARGET="$ROOT/spec/python/tests/test_emulator_brand_migration.py" \
    ZEN_UI_PYTHON_REPORT="$report_name" \
    run_python legacy-upgrade || python_status=$?
  report_test_results \
    "Legacy upgrade/Python" "$ARTIFACTS/python/$report_name"
  validate_legacy_upgrade_report \
    "$ARTIFACTS/python/$report_name" || report_status=$?
  if [[ "$python_status" -ne 0 ]]; then return "$python_status"; fi
  if [[ "$report_status" -ne 0 ]]; then return "$report_status"; fi
  return "$python_status"
}

run_test_suite() {
  local runtime="$1"
  local lua_status=0
  local python_status=0
  run_lua || lua_status=$?
  ZEN_UI_RUN_EMULATOR=1 run_python "$runtime" || python_status=$?
  report_test_results \
    "Lua/Busted" "$ARTIFACTS/lua/junit.xml" \
    "Python/pytest" "$ARTIFACTS/python/junit.xml"
  if [[ "$lua_status" -ne 0 ]]; then return "$lua_status"; fi
  return "$python_status"
}

run_lua_suite() {
  local lua_status=0
  run_lua || lua_status=$?
  report_test_results "Lua/Busted" "$ARTIFACTS/lua/junit.xml"
  return "$lua_status"
}

package_check() {
  (
    cd "$ROOT"
    bash build.sh

    local package_tmp
    package_tmp="$(mktemp -d "${TMPDIR:-/tmp}/zenos-package-check.XXXXXX")"
    trap 'rm -rf "$package_tmp"' EXIT

    verify_archive() {
      local zip_path="$1"
      local expected_root="$2"
      local normalized_list="$3"
      local extract_dir="$4"
      local listing
      local entry

      [[ -f "$zip_path" ]] || { echo "Missing release ZIP: $zip_path" >&2; exit 1; }
      listing="$(unzip -Z1 "$zip_path")"
      [[ -n "$listing" ]] || { echo "Empty release ZIP: $zip_path" >&2; exit 1; }

      while IFS= read -r entry; do
        case "$entry" in
          "$expected_root"|"$expected_root/"*) ;;
          *)
            echo "Unexpected ZIP root in $zip_path: $entry" >&2
            exit 1
            ;;
        esac
      done <<< "$listing"

      if printf '%s\n' "$listing" | grep -Eq '/spec/|/icon-packs/|_spec\.lua$|\.py$|zen_ui_test_driver|/ICON-LIST\.md$|/included-icons\.json$|/zen-icon-pack/'; then
        echo "Test asset leaked into release ZIP: $zip_path" >&2
        exit 1
      fi

      while IFS= read -r entry; do
        if [[ "$entry" == "$expected_root" || "$entry" == "$expected_root/" ]]; then
          printf '.\n'
        else
          printf '%s\n' "${entry#"$expected_root"/}"
        fi
      done <<< "$listing" | sort > "$normalized_list"

      mkdir -p "$extract_dir"
      unzip -q "$zip_path" -d "$extract_dir"
      [[ -f "$extract_dir/$expected_root/_meta.lua" ]] || {
        echo "Release ZIP is missing _meta.lua: $zip_path" >&2
        exit 1
      }
      [[ -f "$extract_dir/$expected_root/main.lua" ]] || {
        echo "Release ZIP is missing main.lua: $zip_path" >&2
        exit 1
      }
      if [[ "${ZENOS_REQUIRE_KINDLE_LAUNCHER:-0}" == "1" ]]; then
        [[ -f "$extract_dir/$expected_root/kindle-launcher/ZenReader.sh" ]] || {
          echo "Release ZIP is missing ZenReader.sh: $zip_path" >&2
          exit 1
        }
        [[ -f "$extract_dir/$expected_root/kindle-launcher/LICENSE" ]] || {
          echo "Release ZIP is missing the launcher license: $zip_path" >&2
          exit 1
        }
      fi
    }

    verify_archive \
      "dist/zenos.koplugin.zip" \
      "zenos.koplugin" \
      "$package_tmp/zenos.list" \
      "$package_tmp/zenos"
    verify_archive \
      "dist/zen_ui.koplugin.zip" \
      "zen_ui.koplugin" \
      "$package_tmp/zen_ui.list" \
      "$package_tmp/zen_ui"

    diff -u "$package_tmp/zenos.list" "$package_tmp/zen_ui.list"
    diff -qr \
      "$package_tmp/zenos/zenos.koplugin" \
      "$package_tmp/zen_ui/zen_ui.koplugin"
  )
}

case "$COMMAND" in
  lua) run_lua_suite ;;
  smoke) run_test_suite stable ;;
  nightly-smoke) run_test_suite nightly ;;
  legacy-upgrade) run_legacy_upgrade ;;
  package-check) package_check ;;
  website-screenshots) run_website_screenshots "${ARGS[@]:1}" ;;
  full) run_test_suite stable; package_check ;;
  update-goldens)
    ZEN_UI_RUN_EMULATOR=1 ZEN_UI_UPDATE_GOLDENS=1 run_lua
    ZEN_UI_RUN_EMULATOR=1 ZEN_UI_UPDATE_GOLDENS=1 run_python stable
    ;;
  *) usage; exit 2 ;;
esac
