#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:317
msgid "Wi-Fi connected, but DNS lookup failed. Internet access may be unavailable. Try reconnecting."
msgstr "La connexió Wi-Fi està establerta, però la consulta DNS ha fallat. És possible que no hi hagi accés a Internet. Torneu-vos a connectar."

#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:58
msgid "Wi-Fi connected, but no default route is available. Check your router or try reconnecting."
msgstr "La connexió Wi-Fi està establerta, però no hi ha cap ruta predeterminada disponible. Comproveu l’encaminador o torneu-vos a connectar."

#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:55
msgid "Wi-Fi connected, but no IP address was assigned. Try reconnecting."
msgstr "La connexió Wi-Fi està establerta, però no s’ha assignat cap adreça IP. Torneu-vos a connectar."

#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:328
msgid "Wi-Fi connected, but the connection check failed. Try reconnecting."
msgstr "La connexió Wi-Fi està establerta, però ha fallat la comprovació de la connexió. Torneu-vos a connectar."

#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:327
msgid "Wi-Fi connected, but the connection check timed out. Internet access may be unavailable."
msgstr "La connexió Wi-Fi està establerta, però s’ha esgotat el temps d’espera de la comprovació de la connexió. És possible que no hi hagi accés a Internet."

#. Type: message
#. Context: if NetworkMgr and NetworkMgr.isOnline and not NetworkMgr:isOnline() then return _("No internet connection.") .. "\n" .. _("Wi-Fi is connected, but the internet is not reachable.") end
#: zen_updater.lua:524
msgid "Wi-Fi is connected, but the internet is not reachable."
msgstr "El Wi-Fi està connectat, però no hi ha accés a Internet."

#. Type: message
#. Context: Message in the Wi-Fi connection notifications.
#: nonblocking_wifi.lua:351
msgid "Wi-Fi is not initialized. Enable Wi-Fi once in Kobo's native interface, then reopen KOReader. Repeat after each device reboot."
msgstr "La Wi-Fi no està inicialitzada. Activeu la Wi-Fi una vegada des de la interfície nativa del Kobo i, tot seguit, torneu a obrir el KOReader. Repetiu aquest procediment després de cada reinici del dispositiu."

