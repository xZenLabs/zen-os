msgstr "ZenPM è stato installato. Riavvia KOReader per usarlo."

#. Type: setting
#. Context: Frequenza del processore in gigahertz; %1 è un valore oppure un intervallo dal minimo al massimo.
#: about_settings.lua:22 about_settings.lua:110
msgid "%1 GHz"
msgstr "%1 GHz"

#. Type: setting
#. Context: Voce delle impostazioni del dispositivo che mostra la frequenza massima del processore; il sottomenu indica il modello, il numero di core e le frequenze.
#: about_settings.lua:98 about_settings.lua:113
msgid "CPU"
msgstr "CPU"

#. Type: setting
#. Context: Etichetta del numero di core del processore nelle informazioni sul dispositivo.
#: about_settings.lua:115
msgid "Cores"
msgstr "Core"

#. Type: setting
#. Context: Etichetta della frequenza attuale o dell’intervallo delle frequenze attuali nelle informazioni sul processore; i valori sono espressi in GHz.
#: about_settings.lua:117
msgid "Current clock"
msgstr "Frequenza attuale"

#. Type: setting
#. Context: Voce delle impostazioni del dispositivo che mostra la capacità totale di archiviazione; il sottomenu indica lo spazio libero, usato e totale.
#: about_settings.lua:76
msgid "Storage"
msgstr "Archiviazione"

#. Type: setting
#. Context: Etichetta della frequenza massima supportata nelle informazioni sul processore; il valore è espresso in GHz.
#: about_settings.lua:119
msgid "Maximum clock"
msgstr "Frequenza massima"

#. Type: setting
#. Context: Voce delle impostazioni del dispositivo che mostra la quantità totale di RAM; il sottomenu indica la memoria in uso, disponibile e totale.
#: about_settings.lua:87
msgid "RAM"
msgstr "RAM"

#. Type: setting
#. Context: Nelle informazioni sul dispositivo indica lo spazio di archiviazione ancora libero. Nei dettagli del libro, anche nel pannello di avvio, indica il tempo di lettura stimato per terminare il libro.
#: about_settings.lua:82 book_details_page.lua:207 book_details.lua:416 book_details.lua:436
msgid "Remaining"
msgstr "Rimanente"

#. Type: setting
#. Context: Etichetta dello spazio di archiviazione o della memoria RAM in uso nelle informazioni sul dispositivo.
#: about_settings.lua:29
msgid "Used"
msgstr "Utilizzato"
