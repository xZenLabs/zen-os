#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:306
msgid "Wi-Fi connected, but DNS lookup failed. Internet access may be unavailable. Try reconnecting."
msgstr "Připojeno k Wi-Fi, ale vyhledávání DNS se nezdařilo. Přístup k internetu pravděpodobně není k dispozici. Zkuste se znovu připojit."

#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:53
msgid "Wi-Fi connected, but no default route is available. Check your router or try reconnecting."
msgstr "Připojeno k Wi-Fi, ale výchozí trasa není k dispozici. Zkontrolujte router nebo se zkuste znovu připojit."

#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:50
msgid "Wi-Fi connected, but no IP address was assigned. Try reconnecting."
msgstr "Připojeno k Wi-Fi, ale nebyla přiřazena žádná IP adresa. Zkuste se znovu připojit."

#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:317
msgid "Wi-Fi connected, but the connection check failed. Try reconnecting."
msgstr "Připojeno k Wi-Fi, ale kontrola připojení selhala. Zkuste se znovu připojit."

#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:316
msgid "Wi-Fi connected, but the connection check timed out. Internet access may be unavailable."
msgstr "Připojeno k Wi-Fi, ale časový limit pro kontrolu připojení vypršel. Přístup k internetu nemusí být k dispozici."

#. Type: message
#. Context: Zpráva v oznámeních o připojení k Wi-Fi.
#: nonblocking_wifi.lua:340
msgid "Wi-Fi is not initialized. Enable Wi-Fi once in Kobo's native interface, then reopen KOReader. Repeat after each device reboot."
msgstr "Wi-Fi není inicializováno. V nativním rozhraní Kobo povolte Wi-Fi a poté znovu otevřete KOReader. Opakujte po každém restartu zařízení."

