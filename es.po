#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:306
msgid "Wi-Fi connected, but DNS lookup failed. Internet access may be unavailable. Try reconnecting."
msgstr "Conexión Wi-Fi establecida, pero la resolución DNS falló. Es posible que no haya acceso a internet. Intente volver a conectarse."

#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:53
msgid "Wi-Fi connected, but no default route is available. Check your router or try reconnecting."
msgstr "Conexión Wi-Fi disponible, pero no hay ruta predeterminada. Compruebe su router o intente volver a conectarse."

#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:50
msgid "Wi-Fi connected, but no IP address was assigned. Try reconnecting."
msgstr "Conexión Wi-Fi establecida, pero no se ha asignado ninguna dirección IP. Intente volver a conectarse."

#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:317
msgid "Wi-Fi connected, but the connection check failed. Try reconnecting."
msgstr "Conexión Wi-Fi establecida, pero la comprobación de conexión falló. Intente reconectarse."

#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:316
msgid "Wi-Fi connected, but the connection check timed out. Internet access may be unavailable."
msgstr "Conexión Wi-Fi establecida, pero la comprobación de conexión ha caducado. Es posible que no haya acceso a Internet."

#. Type: message
#. Context: Mensaje en las notificaciones de conexión Wi-Fi.
#: nonblocking_wifi.lua:340
msgid "Wi-Fi is not initialized. Enable Wi-Fi once in Kobo's native interface, then reopen KOReader. Repeat after each device reboot."
msgstr "El Wi-Fi no está inicializado. Activa el Wi-Fi una vez en la interfaz nativa de Kobo y vuelve a abrir KOReader. Repite después de cada reinicio del dispositivo."

